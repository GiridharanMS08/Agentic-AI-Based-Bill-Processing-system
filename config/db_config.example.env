# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=bill_analyzer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Gemini is optional. Leave empty for a fully local run.
# A free-tier-friendly stable model is used by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
GEMINI_MAX_CALLS_PER_FILE=2
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_SECONDS=2
GEMINI_TIMEOUT_SECONDS=60

# Local OCR
RAPIDOCR_DPI=200
OCR_MIN_CONFIDENCE=60

# Pipeline limits
MAX_FILES_PER_RUN=500
LOG_LEVEL=INFO
